{
  "name": "@api3/commons",
  "version": "2.0.0",
  "description": "Common utilities, modules and configurations used in API3 projects.",
  "license": "MIT",
  "repository": "github:api3dao/commons",
  "exports": {
    ".": {
      "browser": {
        "import": "./dist/esm/universal-index.js",
        "require": "./dist/cjs/universal-index.js",
        "default": "./dist/esm/universal-index.js"
      },
      "import": "./dist/esm/node-index.js",
      "require": "./dist/cjs/node-index.js",
      "default": "./dist/cjs/node-index.js"
    }
  },
  "main": "./dist/cjs/node-index.js",
  "browser": "./dist/esm/universal-index.js",
  "sideEffects": false,
  "engines": {
    "node": ">=20.18.1"
  },
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "build": "pnpm run build:cjs && pnpm run build:esm",
    "build:cjs": "tsc --project tsconfig.cjs.json && echo '{ \"type\": \"commonjs\" }' > dist/cjs/package.json",
    "build:esm": "tsc --project tsconfig.esm.json && echo '{ \"type\": \"module\" }' > dist/esm/package.json",
    "clean": "rm -rf coverage dist",
    "eslint:check": "eslint --report-unused-disable-directives --cache . --max-warnings 0",
    "eslint:fix": "pnpm run eslint:check --fix",
    "prepare": "husky",
    "prepublishOnly": "pnpm i && pnpm run clean && pnpm run build",
    "prettier:check": "prettier --check \"./**/*.{js,ts,md,json}\"",
    "prettier:fix": "prettier --write \"./**/*.{js,ts,md,json}\"",
    "release:tag": "ts-node scripts/tag-and-release.ts",
    "test": "jest",
    "tsc": "tsc --project .",
    "verify:dist": "ts-node scripts/verify-dist.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "api3",
    "commons",
    "utilities"
  ],
  "dependencies": {
    "@api3/ois": "^3.0.0",
    "@octokit/rest": "^20.1.1",
    "axios": "^1.20.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "lodash": "^4.18.1",
    "winston": "^3.19.0",
    "winston-console-format": "^1.0.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@api3/eslint-plugin-commons": "^4.0.0",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^24.13.2",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "prettier": "^3.9.8",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "type-plus": "^7.6.2",
    "typescript": "^7.0.2"
  }
}
